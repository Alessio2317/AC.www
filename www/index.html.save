<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Alessio Cainarca — TPS</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=Syncopate:wght@700&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0a0a0f;
      --surface: #111118;
      --border: #1e1e2e;
      --accent: #5b6fff;
      --accent2: #00e5c0;
      --text: #e8e8f0;
      --muted: #6b6b80;
      --card: #13131d;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'DM Mono', monospace;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    .blob {
      position: fixed;
      border-radius: 50%;
      filter: blur(120px);
      pointer-events: none;
      z-index: 0;
    }
    .blob-1 {
      width: 500px; height: 500px;
      background: rgba(91, 111, 255, 0.12);
      top: -100px; left: -100px;
    }
    .blob-2 {
      width: 400px; height: 400px;
      background: rgba(0, 229, 192, 0.08);
      bottom: 100px; right: -80px;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 48px;
      border-bottom: 1px solid var(--border);
      background: rgba(10, 10, 15, 0.85);
      backdrop-filter: blur(16px);
    }

    .nav-logo {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 1.1rem;
      letter-spacing: -0.02em;
      color: var(--text);
      text-decoration: none;
    }
    .nav-logo span { color: var(--accent); }

    .nav-tag {
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border: 1px solid var(--border);
      padding: 6px 14px;
      border-radius: 100px;
    }

    /* HERO */
    .hero {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 120px 48px 80px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .hero-eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 32px;
      animation: fadeUp 0.6s ease both;
    }

    .hero-eyebrow .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--accent2);
      box-shadow: 0 0 12px var(--accent2);
      animation: pulse 2s ease infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }

    .hero-eyebrow span {
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .hero-title {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(3rem, 8vw, 6.5rem);
      line-height: 0.95;
      letter-spacing: -0.03em;
      margin-bottom: 24px;
      animation: fadeUp 0.6s 0.1s ease both;
    }

    .hero-title .name-first { color: var(--text); }
    .hero-title .name-last {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--accent);
      font-family: 'Syncopate', sans-serif;
      font-weight: 700;
      font-size: clamp(2.2rem, 5.8vw, 5rem);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero-subtitle {
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.7;
      max-width: 480px;
      margin-bottom: 56px;
      animation: fadeUp 0.6s 0.2s ease both;
    }

    .hero-stats {
      display: flex;
      gap: 40px;
      animation: fadeUp 0.6s 0.3s ease both;
    }

    .stat { display: flex; flex-direction: column; gap: 4px; }

    .stat-num {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.8rem;
      color: var(--accent);
    }

    .stat-label {
      font-size: 0.7rem;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* SECTION */
    .section {
      position: relative;
      z-index: 1;
      max-width: 1100px;
      margin: 0 auto;
      padding: 80px 48px;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      gap: 16px;
      margin-bottom: 48px;
    }

    .section-title {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.6rem;
      letter-spacing: -0.02em;
    }

    .section-line {
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .section-count {
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.1em;
    }

    /* GROUPS */
    .ex-groups { display: flex; flex-direction: column; gap: 48px; }

    .ex-group-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 18px;
    }

    .ex-group-tag {
      font-family: 'Syncopate', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #fff;
      white-space: nowrap;
      background: rgba(91,111,255,0.75);
      padding: 5px 14px;
      border-radius: 6px;
      box-shadow: 0 0 10px rgba(91,111,255,0.4), 0 0 24px rgba(91,111,255,0.15);
    }

    .ex-group-line {
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .ex-group-count {
      font-size: 0.68rem;
      color: var(--muted);
      letter-spacing: 0.1em;
    }

    /* BUTTON GRID */
    .ex-btn-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 10px;
    }

    .ex-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 16px 20px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      text-decoration: none;
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      letter-spacing: 0.03em;
      transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.15s, box-shadow 0.2s;
      position: relative;
      overflow: hidden;
    }

    .ex-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(91,111,255,0.08) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.25s;
    }

    .ex-btn:hover {
      border-color: rgba(91,111,255,0.6);
      background: rgba(91,111,255,0.06);
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(91,111,255,0.12);
    }

    .ex-btn:hover::after { opacity: 1; }

    .ex-btn-inner {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
      position: relative;
      z-index: 1;
    }

    .ex-btn-key {
      font-family: 'Syncopate', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1;
      transition: color 0.2s, text-shadow 0.2s;
    }

    .ex-btn:hover .ex-btn-key {
      color: var(--accent);
      text-shadow: 0 0 20px rgba(91,111,255,0.6);
    }

    .ex-btn-label {
      font-size: 0.65rem;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      letter-spacing: 0.04em;
      transition: color 0.2s;
    }

    .ex-btn:hover .ex-btn-label {
      color: rgba(255,255,255,0.6);
    }

    .ex-btn-arrow {
      font-size: 0.75rem;
      color: var(--muted);
      transition: color 0.2s, transform 0.2s;
      flex-shrink: 0;
      position: relative;
      z-index: 1;
    }

    .ex-btn:hover .ex-btn-arrow {
      color: var(--accent);
      transform: translateX(3px);
    }

    /* PLACEHOLDER BTN */
    .ex-btn.placeholder {
      border-style: dashed;
      opacity: 0.25;
      pointer-events: none;
      cursor: default;
    }

    /* FOOTER */
    footer {
      position: relative;
      z-index: 1;
      border-top: 1px solid var(--border);
      padding: 32px 48px;
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .footer-left { font-size: 0.75rem; color: var(--muted); }
    .footer-left strong { color: var(--text); font-family: 'Syne', sans-serif; }
    .footer-right { font-size: 0.7rem; color: var(--muted); letter-spacing: 0.08em; }

    /* ANIMATIONS */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .ex-groups .ex-group {
      opacity: 0;
      animation: fadeUp 0.5s ease both;
    }
    .ex-groups .ex-group:nth-child(1) { animation-delay: 0.05s; }
    .ex-groups .ex-group:nth-child(2) { animation-delay: 0.15s; }
    .ex-groups .ex-group:nth-child(3) { animation-delay: 0.25s; }

    .divider { max-width: 1100px; margin: 0 auto; padding: 0 48px; }
    .divider hr { border: none; border-top: 1px solid var(--border); }

    @media (max-width: 640px) {
      nav { padding: 16px 24px; }
      .hero { padding: 100px 24px 60px; }
      .section { padding: 60px 24px; }
      footer { padding: 28px 24px; flex-direction: column; gap: 12px; text-align: center; }
      .hero-stats { gap: 24px; }
      .exercises-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <nav>
    <a href="#" class="nav-logo">AC<span>.</span></a>
    <span class="nav-tag">TPS · Esercizi</span>
  </nav>

  <section class="hero">
    <div class="hero-eyebrow">
      <div class="dot"></div>
      <span>Portfolio scolastico · Anno 2025/26</span>
    </div>
    <h1 class="hero-title">
      <span class="name-first">Alessio<br></span>
      <span class="name-last">Cainarca</span>
    </h1>
    <p class="hero-subtitle">
      Raccolta degli esercizi svolti durante il corso di
      <strong style="color: var(--text)">Tecnologie e Progettazione di Sistemi Informatici</strong>.
      Ogni card porta alla pagina dell'esercizio corrispondente.
    </p>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num" id="count-done">0</span>
        <span class="stat-label">Esercizi svolti</span>
      </div>
      <div class="stat">
        <span class="stat-num">TPS</span>
        <span class="stat-label">Materia</span>
      </div>
      <div class="stat">
        <span class="stat-num">2025/26</span>
        <span class="stat-label">Anno</span>
      </div>
    </div>
  </section>

  <div class="divider"><hr></div>

  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Esercizi</h2>
      <div class="section-line"></div>
      <span class="section-count" id="sec-count">— —</span>
    </div>

    <div class="ex-groups">

      <!-- ── ES02 ── -->
      <div class="ex-group">
        <div class="ex-group-header">
          <div class="ex-group-tag">ES02</div>
          <div class="ex-group-line"></div>
          <div class="ex-group-count">3 esercizi</div>
        </div>
        <div class="ex-btn-grid">
          <a class="ex-btn" href="ES02/Es02-0.html">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">A</span>
              <span class="ex-btn-label">Hello World</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- ── ES03 ── -->
      <div class="ex-group">
        <div class="ex-group-header">
          <div class="ex-group-tag">ES03</div>
          <div class="ex-group-line"></div>
          <div class="ex-group-count">3 esercizi</div>
        </div>
        <div class="ex-btn-grid">
          <a class="ex-btn" href="ES03/Es03-A.html">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">A</span>
              <span class="ex-btn-label">Calcolo volume</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
          <a class="ex-btn" href="ES03/Es03-B.html">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">B</span>
              <span class="ex-btn-label">Calcolo di una retta</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
          <a class="ex-btn" href="ES03/Es03-C.html">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">C</span>
              <span class="ex-btn-label">SUfficente o Insufficente</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- ── ES04 ── -->
      <div class="ex-group">
        <div class="ex-group-header">
          <div class="ex-group-tag">ES04</div>
          <div class="ex-group-line"></div>
          <div class="ex-group-count">2 esercizi</div>
        </div>
        <div class="ex-btn-grid">
          <a class="ex-btn" href="ES04/Es04-B.html">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">B</span>
              <span class="ex-btn-label">Contatore 100 => 0</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
          <a class="ex-btn" href="ES04/Es04-C.html">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">C</span>
              <span class="ex-btn-label">Calcolatrice</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
        </div>
      </div>




           <!-- ── ES05 ── -->
      <div class="ex-group">
        <div class="ex-group-header">
          <div class="ex-group-tag">ES05</div>
          <div class="ex-group-line"></div>
          <div class="ex-group-count">2 esercizi</div>
        </div>
        <div class="ex-btn-grid">
          <a class="ex-btn" href="ES05/Es05-A.html">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">A</span>
              <span class="ex-btn-label">Stampa di una persona</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
          <a class="ex-btn" href="https://github.com/Alessio2317/AC.www/blob/main/www/ES05/Es05-B.js">
            <div class="ex-btn-inner">
              <span class="ex-btn-key">B</span>
              <span class="ex-btn-label">Ogetto Libero</span>
            </div>
            <span class="ex-btn-arrow">→</span>
          </a>
        </div>

	<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ES05-B — Calcolatrice</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #0d0d14;
      --grid-line: rgba(255,255,255,0.04);
      --card:      #13131e;
      --card2:     #1a1a28;
      --border:    #2a2a40;
      --text:      #f0ede8;
      --muted:     #6a6880;
      --error:     #e87d7d;
      --ok:        #7de8a0;
    }

    body {
      background: var(--bg);
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 48px 48px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      width: 100%;
      max-width: 320px;
      overflow: hidden;
      animation: fadeUp 0.6s ease both;
    }

    .card-header {
      padding: 1.4rem 1.4rem 1rem;
    }

    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.2rem;
    }

    .card-sub {
      font-size: 0.72rem;
      color: var(--muted);
      font-family: monospace;
    }

    /* Display */
    .display {
      background: var(--card2);
      margin: 0 1rem 0;
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 0.8rem 1.1rem 0.7rem;
      min-height: 80px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    .disp-expr {
      font-size: 0.78rem;
      color: var(--muted);
      font-family: monospace;
      min-height: 16px;
      margin-bottom: 0.2rem;
    }

    .disp-main {
      font-size: 2.6rem;
      font-weight: 200;
      color: var(--text);
      line-height: 1;
      letter-spacing: -0.04em;
      word-break: break-all;
    }

    /* Griglia tasti */
    .btn-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      padding: 1rem;
    }

    .btn {
      border: 1px solid var(--border);
      border-radius: 10px;
      height: 58px;
      font-size: 1.1rem;
      font-weight: 400;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'DM Sans', sans-serif;
      user-select: none;
      transition: transform 0.1s, filter 0.1s;
      background: var(--card2);
      color: var(--text);
    }

    .btn:hover  { filter: brightness(1.25); }
    .btn:active { transform: scale(0.93); }

    .btn-fn {
      background: #1e3a28;
      color: #7de8a0;
      border-color: #2a5a3e;
      font-size: 0.85rem;
    }

    .btn-ac {
      background: #3a1e1e;
      color: #e87d7d;
      border-color: #5a2828;
      font-size: 0.85rem;
    }

    .btn-op {
      background: rgba(232,201,125,0.1);
      color: #e8c97d;
      border-color: rgba(232,201,125,0.3);
    }

    .btn-zero {
      grid-column: span 2;
      justify-content: flex-start;
      padding-left: 20px;
    }

    /* Risultato */
    .result {
      margin: 0 1rem 1rem;
      padding: 0.9rem 1.1rem;
      border-radius: 10px;
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      font-weight: 700;
      display: none;
      animation: fadeUp 0.3s ease both;
    }
    .result.ok {
      background: rgba(125,232,160,0.07);
      border: 1px solid rgba(125,232,160,0.25);
      color: var(--ok);
      display: block;
    }
    .result.err {
      background: rgba(232,125,125,0.07);
      border: 1px solid rgba(232,125,125,0.25);
      color: var(--error);
      display: block;
    }
    .result .res-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.62rem;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0.65;
      margin-bottom: 0.2rem;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <div class="card">

    <div class="card-header">
      <div class="card-title">Calcolatrice</div>
      <div class="card-sub">Calcolatrice stile iOS con memoria operazione</div>
    </div>

    <div class="display">
      <div class="disp-expr" id="disp-expr"></div>
      <div class="disp-main" id="disp-main">0</div>
    </div>

    <div class="btn-grid">
      <!-- riga 1 -->
      <button class="btn btn-ac"  onclick="pressAC()">AC</button>
      <button class="btn btn-fn"  onclick="pressSign()">+/−</button>
      <button class="btn btn-fn"  onclick="pressPercent()">%</button>
      <button class="btn btn-op"  onclick="pressOp('/')">÷</button>
      <!-- riga 2 -->
      <button class="btn" onclick="pressNum('7')">7</button>
      <button class="btn" onclick="pressNum('8')">8</button>
      <button class="btn" onclick="pressNum('9')">9</button>
      <button class="btn btn-op"  onclick="pressOp('*')">×</button>
      <!-- riga 3 -->
      <button class="btn" onclick="pressNum('4')">4</button>
      <button class="btn" onclick="pressNum('5')">5</button>
      <button class="btn" onclick="pressNum('6')">6</button>
      <button class="btn btn-op"  onclick="pressOp('-')">−</button>
      <!-- riga 4 -->
      <button class="btn" onclick="pressNum('1')">1</button>
      <button class="btn" onclick="pressNum('2')">2</button>
      <button class="btn" onclick="pressNum('3')">3</button>
      <button class="btn btn-op"  onclick="pressOp('+')">+</button>
      <!-- riga 5 -->
      <button class="btn btn-zero" onclick="pressNum('0')">0</button>
      <button class="btn" onclick="pressDot()">.</button>
      <button class="btn btn-op"  onclick="pressEq()">=</button>
    </div>

    <div class="result" id="result">
      <div class="res-label" id="res-label">Risultato</div>
      <span id="res-text"></span>
    </div>

  </div>

  <script>
    /* ======================================================
       JS ORIGINALE — invariato
    ====================================================== */
    function calcola() {
      const n1 = document.getElementById('num1') ? document.getElementById('num1').value.trim() : current;
      const n2 = document.getElementById('num2') ? document.getElementById('num2').value.trim() : '';
      const opVal = document.getElementById('op') ? document.getElementById('op').value : '';
      const resultDiv = document.getElementById('result');
      const resText   = document.getElementById('res-text');
      const resLabel  = document.getElementById('res-label');

      resultDiv.className = 'result';

      // validazione
      if (n1 === '' || n2 === '' || opVal === '') {
        resLabel.textContent = 'Errore';
        resText.textContent  = 'Input non valido: compila tutti i campi.';
        resultDiv.classList.add('err');
        return;
      }

      const a = parseFloat(n1);
      const b = parseFloat(n2);

      if (isNaN(a) || isNaN(b)) {
        resLabel.textContent = 'Errore';
        resText.textContent  = 'Input non valido: i valori inseriti non sono numeri.';
        resultDiv.classList.add('err');
        return;
      }

      // calcolo
      const operazioni = {
        '+':  (a, b) => a + b,
        '-':  (a, b) => a - b,
        '*':  (a, b) => a * b,
        '/':  (a, b) => a / b,
        '**': (a, b) => a ** b,
      };

      if (opVal === '/' && b === 0) {
        resLabel.textContent = 'Errore';
        resText.textContent  = 'Input non valido: divisione per zero non consentita.';
        resultDiv.classList.add('err');
        return;
      }

      if (!operazioni[opVal]) {
        resLabel.textContent = 'Errore';
        resText.textContent  = 'Input non valido: operazione non riconosciuta.';
        resultDiv.classList.add('err');
        return;
      }

      const risultato = operazioni[opVal](a, b);

      // output
      resLabel.textContent = `${a} ${opVal} ${b} =`;
      resText.textContent  = risultato;
      resultDiv.classList.add('ok');
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Enter') calcola();
    });

    /* ======================================================
       NUOVE FUNZIONI — logica tasti iOS (aggiunte)
    ====================================================== */
    let current    = '0';
    let prev       = null;
    let pendingOp  = null;
    let justEvaled = false;

    const dispMain = document.getElementById('disp-main');
    const dispExpr = document.getElementById('disp-expr');

    function updateDisplay(v) {
      let s = String(v);
      if (s.length > 12) s = parseFloat(v).toExponential(4);
      dispMain.textContent = s;
    }

    function showResult(val, label, type) {
      const resultDiv = document.getElementById('result');
      const resText   = document.getElementById('res-text');
      const resLabel  = document.getElementById('res-label');
      resultDiv.className = 'result ' + type;
      resLabel.textContent = label;
      resText.textContent  = val;
    }

    function pressNum(n) {
      if (justEvaled) { current = n; justEvaled = false; }
      else if (current === '0') current = n;
      else if (current.length < 12) current += n;
      updateDisplay(current);
    }

    function pressDot() {
      if (justEvaled) { current = '0.'; justEvaled = false; }
      else if (!current.includes('.')) current += '.';
      updateDisplay(current);
    }

    function pressOp(o) {
      if (pendingOp && !justEvaled) calcInternal();
      prev      = parseFloat(current);
      pendingOp = o;
      justEvaled = false;
      const simboli = { '+': '+', '-': '−', '*': '×', '/': '÷' };
      dispExpr.textContent = prev + ' ' + (simboli[o] || o);
      current = '0';
      document.getElementById('result').className = 'result';
    }

    function calcInternal() {
      if (pendingOp === null || prev === null) return;
      const a = prev;
      const b = parseFloat(current);

      if (pendingOp === '/' && b === 0) {
        showResult('Divisione per zero non consentita.', 'Errore', 'err');
        return;
      }

      const operazioni = {
        '+':  (a, b) => a + b,
        '-':  (a, b) => a - b,
        '*':  (a, b) => a * b,
        '/':  (a, b) => a / b,
      };

      let res = operazioni[pendingOp](a, b);
      if (typeof res === 'number') res = parseFloat(res.toPrecision(10));

      const simboli = { '+': '+', '-': '−', '*': '×', '/': '÷' };
      const sim = simboli[pendingOp] || pendingOp;
      dispExpr.textContent = `${a} ${sim} ${b} =`;
      showResult(res, `${a} ${sim} ${b} =`, 'ok');

      current    = String(res);
      prev       = null;
      pendingOp  = null;
      justEvaled = true;
      updateDisplay(current);
    }

    function pressEq() { calcInternal(); }

    function pressAC() {
      current = '0'; prev = null; pendingOp = null; justEvaled = false;
      dispExpr.textContent = '';
      updateDisplay('0');
      document.getElementById('result').className = 'result';
    }

    function pressSign() {
      if (current !== '0') {
        current = String(parseFloat(current) * -1);
        updateDisplay(current);
      }
    }

    function pressPercent() {
      current = String(parseFloat(current) / 100);
      updateDisplay(current);
    }
  </script>

</body>
</html>
	        
      </div>
    </div>
  </section>

  <footer>
    <div class="footer-left">
      <strong>Alessio Cainarca</strong> · TPS
    </div>
    <div class="footer-right">Istituto Tecnico · 2025/26</div>
  </footer>

  <script>
    const realBtns = document.querySelectorAll('.ex-btn:not(.placeholder)');
    const countEl = document.getElementById('count-done');
    const secCount = document.getElementById('sec-count');

    let count = 0;
    const target = realBtns.length;
    const interval = setInterval(() => {
      if (count >= target) { clearInterval(interval); return; }
      count++;
      countEl.textContent = count;
    }, 80);

    const groups = document.querySelectorAll('.ex-group').length;
    secCount.textContent = `${groups} sezioni · ${target} esercizi`;
  </script>

</body>
</html>
